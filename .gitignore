# Build
/target/
**/*.rs.bk

# Scanner output — regenerated by every run, never committed
*.sarif
plumber-report.json
plumber-pbom.json
plumber-cyclonedx-sbom.json
lcov.info
coverage/

# Environment
.env
.env.*
!.env.example

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Claude Code agent worktrees (nested git checkouts — never commit them)
.claude/worktrees/
# Machine-local Claude Code settings (absolute paths, personal overrides)
.claude/settings.local.json

# Recorded scanner output is a test fixture, whatever its extension.
!tests/fixtures/**
